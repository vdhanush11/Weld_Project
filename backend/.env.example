# Weld Quality Inspection API Environment Configuration
APP_NAME=Welding Quality Detection API
APP_VERSION=1.0.0
DEBUG=false
HOST=0.0.0.0
PORT=8000

# CORS Origins (comma separated or JSON array)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","*"]

# YOLO Model Configuration
MODEL_PATH=runs/detect/YOLO Weld Detection project/weld_yolo_training/weights/best.pt
MODEL_VERSION=weld-yolo-v1
CONFIDENCE_THRESHOLD=0.25
DEFECT_CONFIDENCE_THRESHOLD=0.50
UNCERTAINTY_THRESHOLD=0.35
IOU_THRESHOLD=0.45
DEVICE=auto  # "cpu", "cuda", "0", or "auto"

# Storage Directories
UPLOAD_DIR=backend/uploads
MAX_FILE_SIZE_MB=25

# Database Configuration (SQLite by default, or PostgreSQL: postgresql+asyncpg://user:pass@host/dbname)
DATABASE_URL=sqlite+aiosqlite:///./backend/weld_inspections.db
